FAL_KEY=your-fal-api-key-here
PORT=3000

# Optional: set to enable automatic model selection by Claude.
# When set, FAL_MODEL below is ignored — Claude picks the best model per request.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5

# Used only when ANTHROPIC_API_KEY is not set (fixed model mode).
FAL_MODEL=fal-ai/ltx-video
